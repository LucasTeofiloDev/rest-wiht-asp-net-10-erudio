{

  "MSSQLServerSQLConnection": {
    "MSSQLServerSQLConnectionString": "Data Source=localhost;Initial Catalog=asp_net_10;Trusted_Connection=true; TrustServerCertificate=true"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning",
        "RestWithASPNET10" : "Debug"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  
  "AllowedHosts": "*"
}
